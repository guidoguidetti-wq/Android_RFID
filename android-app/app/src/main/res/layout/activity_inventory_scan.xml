<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header con back e menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inventory"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Menu"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Info inventario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F5F5F5">

        <TextView
            android:id="@+id/tvInventoryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20.12.2025"
            android:textSize="14sp"
            android:textColor="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvInventoryName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Test Pic 1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <!-- Inventory Mode Badge with Expected Count -->
            <LinearLayout
                android:id="@+id/llInventoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvInventoryMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Normal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvExpectedTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(8)"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Contatore principale -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Contatore TOTALE tag in inventario -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tags Counter"
            android:textSize="18sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvTotalTagsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:text="0"
            android:textSize="100sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <!-- Sub-counters: Expected / Unexpected / Lost -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp">

            <!-- Expected Counter (Verde) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvExpectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expected"
                    android:textSize="12sp"
                    android:textColor="#666666" />
            </LinearLayout>

            <!-- Unexpected Counter (Arancione) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvUnexpectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unexpected"
                    android:textSize="12sp"
                    android:textColor="#666666" />
            </LinearLayout>

            <!-- Lost Counter (Rosso) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvLostCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#F44336" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lost"
                    android:textSize="12sp"
                    android:textColor="#666666" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Buttons Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnInfo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="Details"
            android:textSize="10sp"
            android:background="@drawable/button_border"
            app:backgroundTint="@null"
            android:textColor="#2196F3"
            android:drawableTop="@drawable/ic_info"
            android:drawablePadding="2dp"
            android:padding="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="Settings"
            android:textSize="10sp"
            android:background="@drawable/button_border"
            app:backgroundTint="@null"
            android:textColor="#FF9800"
            android:drawableTop="@drawable/ic_settings"
            android:drawablePadding="2dp"
            android:padding="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnClearInventory"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="CLEAR"
            android:textSize="10sp"
            android:background="@drawable/button_border"
            app:backgroundTint="@null"
            android:textColor="#F44336"
            android:drawableTop="@drawable/ic_clear"
            android:drawablePadding="2dp"
            android:padding="4dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Buttons Row 2 (CLOSE and DELETE) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnCloseInventory"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="CLOSE INV"
            android:textSize="10sp"
            android:background="@drawable/button_border"
            app:backgroundTint="@null"
            android:textColor="#9C27B0"
            android:drawableTop="@drawable/ic_close"
            android:drawablePadding="2dp"
            android:padding="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnDeleteInventory"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="DELETE INV"
            android:textSize="10sp"
            android:background="@drawable/button_border"
            app:backgroundTint="@null"
            android:textColor="#D32F2F"
            android:drawableTop="@drawable/ic_delete"
            android:drawablePadding="2dp"
            android:padding="4dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Play/Pause button (cerchio verde lime) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="8dp">

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:text="▶"
            android:textSize="28sp"
            android:backgroundTint="#CCFF00"
            android:textColor="#000000"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Connection Progress Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <ProgressBar
            android:id="@+id/progressConnection"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting..."
            android:textSize="12sp"
            android:textColor="#FF9800"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Status reader -->
    <TextView
        android:id="@+id/tvReaderStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reader Disconnected"
        android:textSize="14sp"
        android:textColor="#F44336"
        android:layout_gravity="center"
        android:padding="8dp" />
</LinearLayout>
