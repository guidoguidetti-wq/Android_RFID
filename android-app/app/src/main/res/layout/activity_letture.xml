<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Indietro"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Letture"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- Content scrollabile -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== SEZIONE: MODALITÀ LETTURA ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modalità Lettura"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RadioGroup
                        android:id="@+id/rgModalitaLettura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbSolaLettura"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sola Lettura"
                            android:textSize="16sp"
                            android:checked="true"
                            android:paddingStart="8dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rbRegistraTrasferimento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Registra Trasferimento"
                            android:textSize="16sp"
                            android:paddingStart="8dp" />
                    </RadioGroup>

                    <!-- Campi trasferimento (visibili solo se Registra Trasferimento) -->
                    <LinearLayout
                        android:id="@+id/layoutTrasferimento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"
                            android:layout_marginBottom="12dp" />

                        <!-- Place -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Luogo Destinazione"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinnerPlace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp" />

                        <!-- Zone -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Zona Destinazione"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinnerZone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp" />

                        <!-- Riferimento -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Riferimento"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etRiferimento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Riferimento (opzionale)"
                            android:inputType="text"
                            android:maxLines="1"
                            android:background="@android:drawable/edit_text"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Note -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Note"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Note (opzionale)"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:maxLines="4"
                            android:gravity="top"
                            android:background="@android:drawable/edit_text"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== SEZIONE: CHECKLIST ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modalità Checklist"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RadioGroup
                        android:id="@+id/rgChecklist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbNoChecklist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No Checklist"
                            android:textSize="16sp"
                            android:checked="true"
                            android:paddingStart="8dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rbChecklistSku"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Checklist SKU"
                            android:textSize="16sp"
                            android:paddingStart="8dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rbChecklistEpc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Checklist EPC"
                            android:textSize="16sp"
                            android:paddingStart="8dp" />
                    </RadioGroup>

                    <!-- Campo codice checklist (visibile solo se SKU o EPC) -->
                    <LinearLayout
                        android:id="@+id/layoutChecklistCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Codice Checklist"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <EditText
                                android:id="@+id/etChecklistCode"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Inserisci o scansiona codice"
                                android:inputType="text"
                                android:maxLines="1"
                                android:background="@android:drawable/edit_text"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:imeOptions="actionSearch" />

                            <ImageButton
                                android:id="@+id/btnScanChecklistBarcode"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@android:drawable/ic_menu_camera"
                                android:contentDescription="Scansiona barcode"
                                android:tint="#000000" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ===== FOOTER: Pulsanti ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="START"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="CONFIRM"
            android:textStyle="bold"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:enabled="false" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="CANCEL"
            android:textStyle="bold"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
